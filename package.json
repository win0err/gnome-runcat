{
  "name": "runcat",
  "private": true,
  "scripts": {
    "build:compile": "tsc --project tsconfig.json",
    "build:prettify": "eslint --fix --rule 'max-len: off' --rule 'no-underscore-dangle: off' .build/",
    "build": "npm run build:compile && npm run build:prettify",
    "test:lint": "eslint src/",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run test:lint && npm run test:typecheck"
  },
  "repository": "win0err/gnome-runcat",
  "author": "Sergei Kolesnikov <sergei@kolesnikov.se>",
  "license": "GPL-3.0",
  "devDependencies": {
    "@girs/adw-1": "4.1.0",
    "@girs/clutter-18": "4.1.0",
    "@girs/gio-2.0": "4.1.0",
    "@girs/gjs": "4.1.0",
    "@girs/glib-2.0": "4.1.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/gobject-2.0": "4.1.0",
    "@girs/gtop-2.0": "4.1.0",
    "@girs/gtk-4.0": "4.1.0",
    "@girs/st-18": "4.1.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.47.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~6.0.3"
  }
}
